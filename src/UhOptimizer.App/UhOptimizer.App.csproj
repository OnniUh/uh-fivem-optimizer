<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>UhFiveMOptimizer</AssemblyName>
    <RootNamespace>UhOptimizer.App</RootNamespace>
    <Version>0.3.1</Version>
    <DefineConstants Condition="'$(PublishSingleFile)' == 'true'">$(DefineConstants);SINGLE_FILE</DefineConstants>
    <Company>Uh</Company>
    <Product>Uh FiveM Optimizer</Product>
    <Description>FiveM graphics presets, reversible tuning, and reviewed temporary-file cleanup.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\UhOptimizer.Core\UhOptimizer.Core.csproj" /></ItemGroup>
</Project>
