<Window x:Class="UhOptimizer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:UhOptimizer.App.Controls"
        Title="Uh FiveM Optimizer" Width="1280" Height="900" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="#EDF4EF" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Grid Background="{DynamicResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="18,30,18,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,38">
          <Border Background="{DynamicResource PrimaryFill}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" Width="49" Height="49" CornerRadius="17" HorizontalAlignment="Left"><TextBlock Text="Uh" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="Uh FiveM" FontSize="23" FontWeight="SemiBold" Margin="0,17,0,2"/><TextBlock Text="OPTIMIZER / BY UH" FontSize="9" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="YOUR WORKSPACE" Style="{StaticResource Label}" Margin="17,0,0,12"/>
          <Button x:Name="OverviewNav" Content="◈    Overview" Style="{StaticResource NavButton}" Tag="Overview" Click="Navigate"/>
          <Button x:Name="TuneNav" Content="⌁    Windows tuning" Style="{StaticResource NavButton}" Tag="Tune" Click="Navigate"/>
          <Button x:Name="OptimizeNav" Content="▤    Optimizations" Style="{StaticResource NavButton}" Tag="Optimize" Click="Navigate"/>
          <Button x:Name="RestoreNav" Content="↶    Recovery" Style="{StaticResource NavButton}" Tag="Restore" Click="Navigate"/>
          <Button x:Name="AppearanceNav" Content="◉    Appearance" Style="{StaticResource NavButton}" Tag="Appearance" Click="Navigate"/>
          <Button x:Name="UpdatesNav" Content="↥    Updates" Style="{StaticResource NavButton}" Tag="Updates" Click="Navigate"/>
          <Button x:Name="AboutNav" Content="◇    Transparency" Style="{StaticResource NavButton}" Tag="About" Click="Navigate"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="12,0">
          <Border Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="12" Padding="11,6" HorizontalAlignment="Left"><TextBlock Text="●  LOCAL BY DESIGN" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold"/></Border>
          <TextBlock Text="Your setup. Your say." Style="{StaticResource MutedText}" Margin="0,13,0,16"/>
          <TextBlock x:Name="SidebarVersionText" Text="v0.3.1  /  UI preview" FontSize="10" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,27,32,19">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,23">
        <StackPanel Margin="0,0,160,0"><TextBlock Text="FIVEM / SETUP TOOLKIT" Style="{StaticResource Label}" Margin="0,0,0,7"/><TextBlock x:Name="PageTitle" Text="Your setup, at a glance." FontSize="28" FontWeight="Light"/></StackPanel>
        <Button x:Name="ScanButton" Content="↻   Scan again" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ScanClick"/>
        <Button x:Name="AppearanceSaveHeader" Content="Save appearance   ✓" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="SaveAppearanceClick"/>
      </Grid>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" Padding="0,0,10,0">
        <Grid>
          <StackPanel x:Name="OverviewPage">
            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}" Padding="26,22" Margin="0,0,0,18" ClipToBounds="True">
              <Grid MinHeight="190"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,4">
                  <TextBlock Text="SMALL CHANGES. CLEAR CHOICES." Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,11"/>
                  <TextBlock Text="Less friction.&#10;More FiveM." FontSize="36" FontWeight="Light" LineHeight="40"/>
                  <TextBlock Text="Get to know your PC. Tune it on your terms." Style="{StaticResource MutedText}" Margin="0,9,0,17"/>
                  <Button Content="Tune your setup   ↗" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OpenTune"/>
                </StackPanel>
                <Grid Grid.Column="1"><ui:AmbientScene x:Name="HeroScene" AccentColor="{DynamicResource AccentColor}"/><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="13" Padding="11,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"><TextBlock Text="NATIVE MOTION / LIGHT FOOTPRINT" FontSize="8" Foreground="{DynamicResource Accent}"/></Border></Grid>
              </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,-12,18">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="01 / PROCESSOR" Style="{StaticResource Label}"/><TextBlock x:Name="CpuValue" Text="Scanning…" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/><TextBlock x:Name="CpuDetail" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="02 / MEMORY" Style="{StaticResource Label}"/><TextBlock x:Name="RamValue" Text="—" FontSize="28" FontWeight="Light"/><TextBlock Text="System physical memory" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="03 / FREE STORAGE" Style="{StaticResource Label}"/><TextBlock x:Name="DiskValue" Text="—" FontSize="28" FontWeight="Light"/><TextBlock x:Name="DiskDetail" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <Grid><TextBlock Text="THE LIVE PICTURE" Style="{StaticResource Label}"/><TextBlock Text="●  EVERY 2 SECONDS" Foreground="{DynamicResource Accent}" FontSize="9" HorizontalAlignment="Right"/></Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0"><TextBlock x:Name="LiveCpu" Text="CPU / collecting sample" FontSize="19" FontWeight="Light"/><Canvas x:Name="CpuGraph" Height="55" Margin="0,14,0,0" ClipToBounds="True" Background="{DynamicResource Bg}"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock x:Name="LiveRam" Text="RAM / collecting sample" FontSize="19" FontWeight="Light"/><Canvas x:Name="RamGraph" Height="55" Margin="0,14,0,0" ClipToBounds="True" Background="{DynamicResource Bg}"/></StackPanel>
              </Grid>
              <TextBlock Text="Whole-PC CPU and RAM over the last 60 samples. Game FPS is not measured here." Style="{StaticResource MutedText}" Margin="0,13,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="YOUR FIVEM INSTALLATION" Style="{StaticResource Label}"/><TextBlock x:Name="FiveMValue" Text="Scanning…" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FiveMPath" Style="{StaticResource MutedText}" Margin="0,7,0,0"/><TextBlock x:Name="CacheValue" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Locate FiveM" Click="LocateClick" Margin="0,0,0,9"/><Button x:Name="OpenFolderButton" Content="Open folder  ↗" Click="OpenFiveMFolder" IsEnabled="False"/></StackPanel>
            </Grid></Border>
            <TextBlock x:Name="GpuValue" Style="{StaticResource MutedText}" Margin="2,0,0,5"/><TextBlock x:Name="OsValue" Style="{StaticResource MutedText}" Margin="2,0,0,15"/>
            <Button Content="Export diagnostic report   ↗" HorizontalAlignment="Left" Click="ExportClick"/>
          </StackPanel>
          <StackPanel x:Name="TunePage" Visibility="Collapsed">
            <TextBlock Text="Review each choice before you apply it. Results depend on your PC, game settings, and the server you join." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <Grid><TextBlock Text="01 / WINDOWS POWER PLAN" Style="{StaticResource Label}"/><TextBlock Text="●  BACKUP + RESTORE" Foreground="{DynamicResource Accent}" FontSize="9" HorizontalAlignment="Right"/></Grid>
              <TextBlock Text="A little more control over power." FontSize="24" FontWeight="Light"/>
              <TextBlock Text="High performance can reduce power-saving behavior on some PCs. It can also increase heat, fan noise, and battery use. An FPS improvement is not guaranteed. Only plans already available on your PC are listed." Style="{StaticResource MutedText}" Margin="0,11,0,20"/>
              <TextBlock x:Name="ActivePlanValue" Text="Current plan: scanning…" Margin="0,0,0,13"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PlanPicker" AutomationProperties.Name="Target Windows power plan" Margin="0,0,14,0"/><Button x:Name="ApplyButton" Grid.Column="1" Content="Review change   ↗" Style="{StaticResource PrimaryButton}" Click="ApplyClick"/></Grid>
              <TextBlock x:Name="PowerHint" Text="Your original plan is saved before anything changes. Restore it any time from Recovery." Style="{StaticResource MutedText}" Margin="0,15,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="A FEW SETTINGS WORTH A LOOK" Style="{StaticResource Label}" Margin="2,12,0,14"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Game Mode" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Review Windows gaming preferences for this PC." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings   ↗" Tag="ms-settings:gaming-gamemode" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Graphics preference" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="On PCs with multiple GPUs, review the GPU assigned to the actual FiveM game executable." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings   ↗" Tag="ms-settings:display-advancedgraphics" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Background captures" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Review recording options if you do not need gameplay clips." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings   ↗" Tag="ms-settings:gaming-gamedvr" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Startup apps" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Choose which apps you still need to launch with Windows." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings   ↗" Tag="ms-settings:startupapps" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
          <StackPanel x:Name="OptimizePage" Visibility="Collapsed">
            <TextBlock Text="Graphics options target GTA V Legacy. For Enhanced, use in-game graphics settings. Temporary-file cleanup supports both editions." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="01 / LOW-END GRAPHICS · LEGACY" Style="{StaticResource Label}"/><TextBlock Text="Less detail. More room to render." FontSize="25" FontWeight="Light"/>
              <TextBlock Text="Reduce supported texture, shadow, reflection, grass, particle and post-processing settings; reduce draw distance and disable MSAA. Lower visual quality may improve FPS when rendering is the bottleneck. Your GPU, monitor, refresh rate and controls are kept. Close FiveM and GTA V first." Style="{StaticResource MutedText}" Margin="0,12,0,16"/>
              <TextBlock x:Name="GraphicsPathText" Text="Locating FiveM graphics settings…" Style="{StaticResource MutedText}" Margin="0,0,0,15"/>
              <CheckBox x:Name="LegacyEditionCheck" Content="I use FiveM for GTA V Legacy" Margin="0,0,0,14"/>
              <CheckBox x:Name="Resolution720Check" Content="Also lower resolution to at most 1280 × 720" Margin="0,0,0,10"/>
              <TextBlock Text="Optional: a softer image with fewer pixels to render. Existing smaller resolutions are kept. VSync is kept; review it in-game if it limits your frame rate." Style="{StaticResource MutedText}" Margin="48,0,0,18"/>
              <WrapPanel><Button x:Name="GraphicsReviewButton" Content="Preview low-end preset   ↗" Style="{StaticResource PrimaryButton}" Click="GraphicsPreviewClick" Margin="0,0,10,8"/><Button x:Name="ChooseGraphicsButton" Content="Choose settings file" Click="ChooseGraphicsClick" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="GraphicsResultText" Text="The original file is backed up before applying. Restore it from Recovery." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="02 / TEMPORARY FILE CLEANUP" Style="{StaticResource Label}"/><TextBlock Text="Make space before your next session." FontSize="24" FontWeight="Light"/>
              <TextBlock Text="Scan files created and last modified more than 7 days ago. Preview lists every candidate. Locked, protected, linked and changed files are skipped. Cleanup permanently removes files; it is not included in Recovery and does not promise an FPS boost." Style="{StaticResource MutedText}" Margin="0,12,0,18"/>
              <CheckBox x:Name="UserTempCheck" Content="User Temp (%TEMP% + standard local Temp)" IsChecked="True" Margin="0,0,0,12"/>
              <CheckBox x:Name="WindowsTempCheck" Content="Windows Temp (%WINDIR%\Temp)" IsChecked="True" Margin="0,0,0,12"/>
              <CheckBox x:Name="PrefetchCheck" Content="Advanced: old Prefetch .pf files (not recommended)" Margin="0,0,0,8"/>
              <TextBlock Text="Prefetch helps apps launch faster. Clearing it can slow later launches; Windows rebuilds these files. Off by default. No permissions are changed and no administrator access is requested." Style="{StaticResource MutedText}" Margin="48,0,0,18"/>
              <WrapPanel><Button x:Name="CleanupScanButton" Content="Preview cleanup   ↗" Click="CleanupPreviewClick" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button x:Name="CleanupDeleteButton" Content="Review deletion" Click="CleanupDeleteClick" IsEnabled="False" Margin="0,0,10,8"/><Button x:Name="CleanupCancelButton" Content="Cancel" Click="CleanupCancelClick" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="CleanupSummaryText" Text="No scan yet. Your files have not been changed." Style="{StaticResource MutedText}" Margin="0,10,0,10"/>
              <TextBox x:Name="CleanupFilesText" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" Height="145" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="Cleanup candidate file list"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="03 / YOUR LINKED VISUAL PACK · EXPERIMENTAL" Style="{StaticResource Label}"/><TextBlock Text="FiveM for Low End PCs 2.0" FontSize="24" FontWeight="Light"/>
              <TextBlock Text="Legacy only. The 2017 community pack changes visualsettings.dat and timecycle XML. Compatibility and FPS gains are unverified; loading problems are reported. Enhanced currently blocks graphics mods. Use only if your server allows modified visuals. It is separate from the standard preset." Style="{StaticResource MutedText}" Margin="0,12,0,18"/>
              <WrapPanel><Button Content="Open original thread   ↗" Click="VisualPackThreadClick" Margin="0,0,10,8"/><Button x:Name="ImportPackButton" Content="Preview downloaded ZIP" Click="VisualPackImportClick" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="VisualPackResultText" Text="Download the author's ZIP from the original thread, then preview it here. Only visualsettings.dat and timecycle XML under citizen/common/data are accepted. No executables, scripts, or replacement of the whole citizen folder. Originals are backed up." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Ready for a fair comparison?" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Compare FPS on the same server, route, resolution and player load before and after. Server scripts, crowded areas, CPU limits and hardware can keep FPS low even with reduced graphics. A jump from 30–40 to 80–90 FPS cannot be guaranteed." Style="{StaticResource MutedText}" Margin="0,12,0,18"/>
              <Button x:Name="LaunchFiveMButton" Content="Launch FiveM   ↗" HorizontalAlignment="Left" Click="LaunchFiveMClick"/>
              <TextBlock Text="Launch uses the settings you already applied and minimizes this window. It does not clear files, close apps, or change power plans automatically." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="RestorePage" Visibility="Collapsed">
            <TextBlock Text="A saved starting point." FontSize="25" FontWeight="Light" Margin="0,0,0,10"/>
            <TextBlock Text="Closing the app leaves your chosen power plan active. Recovery returns to the exact plan saved before your change, even after a restart." Style="{StaticResource MutedText}" Margin="0,0,0,23"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="YOUR POWER PLAN BACKUP" Style="{StaticResource Label}"/><TextBlock x:Name="BackupTitle" Text="No changes yet" FontSize="23" FontWeight="Light"/><TextBlock x:Name="BackupDetails" Style="{StaticResource MutedText}" Margin="0,13,0,22"/><Button x:Name="RestoreButton" Content="Review restore   ↶" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="RestoreClick" IsEnabled="False"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="GRAPHICS SETTINGS BACKUP" Style="{StaticResource Label}"/><TextBlock x:Name="GraphicsBackupText" Text="No graphics changes yet." Style="{StaticResource MutedText}" Margin="0,0,0,18"/><Button x:Name="GraphicsRestoreButton" Content="Restore graphics settings   ↶" HorizontalAlignment="Left" Click="GraphicsRestoreClick" IsEnabled="False"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="LEGACY VISUAL PACK BACKUP" Style="{StaticResource Label}"/><TextBlock x:Name="PackBackupText" Text="No visual pack imported yet." Style="{StaticResource MutedText}" Margin="0,0,0,18"/><Button x:Name="PackRestoreButton" Content="Restore visual files   ↶" HorizontalAlignment="Left" Click="PackRestoreClick" IsEnabled="False"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Recovery stays on your PC." FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Backups are readable JSON files. Keep them until you restore your changes. A damaged backup blocks new changes instead of being overwritten. Temp cleanup is permanent and has no restore option." Style="{StaticResource MutedText}" Margin="0,9,0,18"/><Button Content="Open backup folder   ↗" HorizontalAlignment="Left" Click="BackupFolderClick"/></StackPanel></Border>
            <TextBlock Text="Settings changed inside Windows Settings are managed by Windows and are not included in the app's power-plan backup." Style="{StaticResource MutedText}" Margin="2,20,0,0"/>
          </StackPanel>
          <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}" Padding="26,20" Margin="0,0,0,19"><Grid MinHeight="130"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="YOUR SPACE. YOUR PALETTE." Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Make it feel like you." FontSize="29" FontWeight="Light"/><TextBlock Text="A live preview, all across the app." Style="{StaticResource MutedText}" Margin="0,9,0,0"/></StackPanel><ui:AmbientScene x:Name="AppearanceScene" Grid.Column="1" AccentColor="{DynamicResource AccentColor}"/></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="01 / CHOOSE AN ACCENT" Style="{StaticResource Label}"/><TextBlock Text="Find your color." FontSize="21" FontWeight="Light"/><TextBlock Text="Pick a palette or enter your own hex color. Changes preview immediately; save when you like the result." Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
              <UniformGrid x:Name="PresetPanel" Columns="3" Margin="0,0,-10,14"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="45" Height="45" CornerRadius="13" Background="{DynamicResource AccentRaw}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" Margin="0,0,12,0"/><TextBox x:Name="CustomColorInput" Grid.Column="1" Height="46" Padding="13,5" Text="#B5F36B" MaxLength="7" CharacterCasing="Upper" FontFamily="Consolas" AutomationProperties.Name="Custom accent hex color" VerticalContentAlignment="Center" Margin="0,0,13,0"/><Button Grid.Column="2" Content="Preview color   ↗" Click="PreviewColorClick"/></Grid>
              <TextBlock x:Name="ColorFeedback" Text="Living green / #B5F36B" Foreground="{DynamicResource Accent}" FontSize="12" Margin="1,13,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="02 / MOTION, YOUR WAY" Style="{StaticResource Label}"/>
              <CheckBox x:Name="ReduceMotionCheck" Content="Reduce motion" Checked="MotionOptionChanged" Unchecked="MotionOptionChanged"/><TextBlock Text="Keep the artwork still and use instant hover/focus states. Windows reduced-motion preferences are also respected." Style="{StaticResource MutedText}" Margin="48,6,0,20"/>
              <CheckBox x:Name="PauseGamingCheck" Content="Pause animations while FiveM is running" IsChecked="True" Checked="MotionOptionChanged" Unchecked="MotionOptionChanged"/><TextBlock Text="Visual motion automatically pauses during a game session, and whenever this window is inactive or minimized." Style="{StaticResource MutedText}" Margin="48,6,0,16"/>
              <Border Background="{DynamicResource Bg}" CornerRadius="12" Padding="13,10"><TextBlock x:Name="MotionStatusText" Text="Subtle motion / 20 frames per second maximum" FontSize="12" Foreground="{DynamicResource Muted}"/></Border>
            </StackPanel></Border>
            <Grid Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Button Content="Save appearance   ✓" Style="{StaticResource PrimaryButton}" Click="SaveAppearanceClick" Margin="0,0,12,0"/><Button Content="Reset to default" Click="ResetAppearanceClick"/></StackPanel></Grid>
            <TextBlock x:Name="AppearanceNotice" Text="Appearance preferences are saved locally on this PC." Style="{StaticResource MutedText}" Margin="2,9,0,0"/>
          </StackPanel>
          <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}" Margin="0,0,0,19"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR INSTALLED VERSION" Style="{StaticResource Label}"/><TextBlock x:Name="InstalledVersionText" Text="v0.3.1" FontSize="31" FontWeight="Light"/><TextBlock Text="Updates stay inside your toolkit." Style="{StaticResource MutedText}" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="15" Padding="14,8"><TextBlock Text="WINDOWS / X64" Foreground="{DynamicResource Accent}" FontSize="10"/></Border></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <TextBlock Text="01 / CHECK WHEN YOU CHOOSE" Style="{StaticResource Label}"/><TextBlock x:Name="UpdateTitle" Text="Ready for the next version?" FontSize="24" FontWeight="Light"/>
              <TextBlock x:Name="UpdateDetails" Text="Check GitHub for a newer release. Checking reads small version files; it does not download the EXE again." Style="{StaticResource MutedText}" Margin="0,12,0,20"/>
              <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" Height="5" BorderThickness="0" Foreground="{DynamicResource AccentRaw}" Background="{DynamicResource Bg}" Margin="0,0,0,22"/>
              <WrapPanel><Button x:Name="CheckUpdateButton" Content="Check for updates   ↻" Style="{StaticResource PrimaryButton}" Click="CheckUpdatesClick" Margin="0,0,12,10"/><Button x:Name="InstallUpdateButton" Content="Download &amp; restart   ↗" Click="InstallUpdateClick" IsEnabled="False" Margin="0,0,12,10"/><Button x:Name="CancelUpdateButton" Content="Cancel" Click="CancelUpdateClick" IsEnabled="False" Margin="0,0,0,10"/></WrapPanel>
              <TextBlock x:Name="UpdateNotice" Text="No automatic checks, background downloads, or account sign-in. New versions are downloaded only after you choose to install them." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="A clear path from source to update." FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Updates come from OnniUh/uh-fivem-optimizer on GitHub. The app checks release metadata, the recorded source commit, file size, and SHA-256 checksums before installation. A verified download can be reused if installation is retried." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Your saved appearance and power-plan backup stay on this PC. The previous EXE is kept beside the installed app as a .previous file. Updating requires write access to the installation folder and runs with normal Windows permissions." Style="{StaticResource MutedText}" Margin="0,12,0,17"/><Button Content="View releases on GitHub   ↗" HorizontalAlignment="Left" Click="ReleasesClick"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="AboutPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Tune your setup. See every change." FontSize="27" FontWeight="Light"/><TextBlock x:Name="AboutVersionText" Text="Uh FiveM Optimizer / v0.3.1" Foreground="{DynamicResource Accent}" Margin="0,11,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="What the app does" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Reads hardware, monitors CPU/RAM, switches existing Windows power plans, applies a low-end graphics preset, imports supported visual-pack files, and previews old temp files for deletion. Power and graphics changes have backups; cleanup is permanent." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Every modification requires your review. Cache inspection is read-only. No FPS gain is guaranteed. Appearance colors and motion preferences are stored locally." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Local, lightweight, and yours." FontSize="19" FontWeight="SemiBold"/><TextBlock Text="No accounts, analytics, ads, background service, or automatic downloads. No embedded browser. The artwork uses native vector drawing; button effects run only in response to your input. Update checks contact GitHub only when you choose to check." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Scans and backups stay on this PC. Reports are exported only when you choose. Normal Windows permissions are used. Antivirus, anti-cheat, services, boot settings and the Windows registry are not changed. Optional visual-pack imports modify only reviewed FiveM visual files." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Built to be inspected." FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Public C# source, recovery tests, and the EXE build workflow are available on GitHub. Published preview releases include SHA-256 checksums and source-commit metadata. A checksum confirms file identity; it is not a security audit." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Native styling inspired by the Sylva reference supplied by Uh. Independent community tool; not affiliated with Cfx.re or Rockstar Games. Game FPS is not measured and no FPS gain is guaranteed." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Text="Ready. Your settings are in your hands." Foreground="{DynamicResource Muted}" FontSize="11"/></Border>
    </Grid>
  </Grid>
</Window>
