<Window x:Class="UhOptimizer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uh FiveM Optimizer" Width="1180" Height="830" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="#EDF3F8" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#10161C" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="18,30,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,38">
          <Border Background="{StaticResource Accent}" Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Left"><TextBlock Text="Uh" FontWeight="Bold" FontSize="24" Foreground="#12210A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="Uh FiveM" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,1"/><TextBlock Text="OPTIMIZER" FontSize="10" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="WORKSPACE" Style="{StaticResource Label}" Margin="16,0,0,10"/>
          <Button x:Name="OverviewNav" Content="01     Overview" Style="{StaticResource NavButton}" Tag="Overview" Click="Navigate"/>
          <Button x:Name="TuneNav" Content="02     Tune your setup" Style="{StaticResource NavButton}" Tag="Tune" Click="Navigate"/>
          <Button x:Name="RestoreNav" Content="03     Restore" Style="{StaticResource NavButton}" Tag="Restore" Click="Navigate"/>
          <Button x:Name="AboutNav" Content="04     Transparency" Style="{StaticResource NavButton}" Tag="About" Click="Navigate"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="10,0">
          <Border Background="#1D2D1D" CornerRadius="5" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="LOCAL BY DESIGN" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/></Border>
          <TextBlock Text="Your settings. Your decision." Style="{StaticResource MutedText}" Margin="0,12,0,12"/>
          <TextBlock Text="v0.1.0  /  by Uh" FontSize="11" Foreground="#6E8091"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,26,32,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <StackPanel><TextBlock Text="FIVEM / SETUP TOOLKIT" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBlock x:Name="PageTitle" Text="Know your setup." FontSize="30" FontWeight="SemiBold"/></StackPanel>
        <Button x:Name="ScanButton" Content="↻  Scan again" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ScanClick"/>
      </Grid>
      <ScrollViewer Grid.Row="1" Padding="0,0,9,0">
        <Grid>
          <StackPanel x:Name="OverviewPage">
            <Border Style="{StaticResource Card}" Background="#18251B" BorderBrush="#354A2A" Margin="0,0,0,18">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="A better session starts with a clear picture." FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Check your PC, review your options, and keep a way back." Style="{StaticResource MutedText}" Margin="0,8,16,0"/></StackPanel>
                <Button Grid.Column="1" Content="Explore tuning  →" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OpenTune"/>
              </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="0,0,-12,18">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROCESSOR" Style="{StaticResource Label}"/><TextBlock x:Name="CpuValue" Text="Scanning…" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CpuDetail" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource Label}"/><TextBlock x:Name="RamValue" Text="—" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Installed physical memory" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="AVAILABLE STORAGE" Style="{StaticResource Label}"/><TextBlock x:Name="DiskValue" Text="—" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="DiskDetail" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <StackPanel>
                <Grid><TextBlock Text="LIVE RESOURCE USE" Style="{StaticResource Label}"/><TextBlock Text="●  2 SECOND INTERVAL" Foreground="{StaticResource Accent}" FontSize="10" HorizontalAlignment="Right"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0"><TextBlock x:Name="LiveCpu" Text="CPU  /  waiting for sample" FontSize="18" FontWeight="SemiBold"/><Canvas x:Name="CpuGraph" Height="64" Margin="0,12,0,0" ClipToBounds="True" Background="#10171C"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock x:Name="LiveRam" Text="RAM  /  waiting for sample" FontSize="18" FontWeight="SemiBold"/><Canvas x:Name="RamGraph" Height="64" Margin="0,12,0,0" ClipToBounds="True" Background="#10171C"/></StackPanel>
                </Grid>
                <TextBlock Text="Whole-PC readings over the last 60 samples. These charts do not measure game FPS." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="FIVEM INSTALLATION" Style="{StaticResource Label}"/><TextBlock x:Name="FiveMValue" Text="Scanning…" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FiveMPath" Style="{StaticResource MutedText}" Margin="0,7,20,0"/><TextBlock x:Name="CacheValue" Style="{StaticResource MutedText}" Margin="0,5,20,0"/></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Locate FiveM" Click="LocateClick" Margin="0,0,0,8"/><Button x:Name="OpenFolderButton" Content="Open folder  ↗" Click="OpenFiveMFolder" IsEnabled="False"/></StackPanel>
              </Grid>
            </Border>
            <TextBlock x:Name="GpuValue" Style="{StaticResource MutedText}" Margin="2,0,0,5"/><TextBlock x:Name="OsValue" Style="{StaticResource MutedText}" Margin="2,0,0,12"/>
            <Button Content="Export diagnostic report…" HorizontalAlignment="Left" Click="ExportClick"/>
          </StackPanel>
          <StackPanel x:Name="TunePage" Visibility="Collapsed">
            <TextBlock Text="Review each change before you apply it. Results depend on your PC, game settings, and the server you join." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
              <Grid><TextBlock Text="01 / WINDOWS POWER PLAN" Style="{StaticResource Label}"/><TextBlock Text="BACKUP + RESTORE" Foreground="{StaticResource Accent}" FontSize="10" HorizontalAlignment="Right"/></Grid>
              <TextBlock Text="Choose how Windows uses power." FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="High performance can reduce power-saving behavior on some PCs. It can also increase heat, fan noise, and battery use. An FPS improvement is not guaranteed. Only plans already available on your PC are listed." Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
              <TextBlock x:Name="ActivePlanValue" Text="Current plan: scanning…" Margin="0,0,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PlanPicker" AutomationProperties.Name="Target Windows power plan" Margin="0,0,12,0"/><Button x:Name="ApplyButton" Grid.Column="1" Content="Review change  →" Style="{StaticResource PrimaryButton}" Click="ApplyClick"/></Grid>
              <TextBlock x:Name="PowerHint" Text="Your current plan is saved to disk before Windows is changed. Restore it any time from the Restore page." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="SETTINGS WORTH REVIEWING" Style="{StaticResource Label}" Margin="2,10,0,12"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Game Mode" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Review Windows gaming preferences for this PC." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings  ↗" Tag="ms-settings:gaming-gamemode" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Graphics preference" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="On PCs with multiple GPUs, review which GPU Windows assigns to the actual FiveM game executable." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings  ↗" Tag="ms-settings:display-advancedgraphics" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Background captures" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Review recording options if you do not need background gameplay clips." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings  ↗" Tag="ms-settings:gaming-gamedvr" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Startup apps" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Review apps that launch with Windows. Choose what you still need." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Open settings  ↗" Tag="ms-settings:startupapps" Click="SettingsClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
          <StackPanel x:Name="RestorePage" Visibility="Collapsed">
            <TextBlock Text="A saved starting point." FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Closing the app leaves your chosen power plan active. Use Restore to return to the exact plan saved before your change, including after a restart." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="POWER PLAN BACKUP" Style="{StaticResource Label}"/><TextBlock x:Name="BackupTitle" Text="No changes yet" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="BackupDetails" Style="{StaticResource MutedText}" Margin="0,12,0,20"/>
              <Button x:Name="RestoreButton" Content="Review restore  ↶" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="RestoreClick" IsEnabled="False"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Recovery is local." FontSize="17" FontWeight="SemiBold"/><TextBlock Text="The backup is a readable JSON file on this PC. Keep it until you have restored your original plan. A damaged backup blocks new changes instead of being overwritten." Style="{StaticResource MutedText}" Margin="0,8,0,16"/><Button Content="Open backup folder  ↗" HorizontalAlignment="Left" Click="BackupFolderClick"/></StackPanel></Border>
            <TextBlock Text="Settings changed inside Windows Settings are managed by Windows and are not included in this app's power-plan backup." Style="{StaticResource MutedText}" Margin="2,18,0,0"/>
          </StackPanel>
          <StackPanel x:Name="AboutPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Background="#18251B" BorderBrush="#354A2A" Margin="0,0,0,18"><StackPanel><TextBlock Text="Tune your setup. See every change." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Uh FiveM Optimizer / v0.1.0" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="What this version does" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Reads hardware and whole-PC resource use, locates FiveM, inspects cache size, and switches existing Windows power plans after your confirmation. It saves the original power plan for restoration." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Windows Settings shortcuts leave those decisions with you. Cache inspection is read-only; clearing cache is not offered as a routine FPS tweak." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Privacy and permissions" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="No accounts, analytics, ads, background service, or automatic downloads. Scans and backups stay on your PC. A diagnostic report is written only when you choose to export it; review it before sharing." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Runs with your normal Windows permissions. If a power-plan change is blocked by policy, the app reports the error. Antivirus, game files, anti-cheat, and Windows services are not modified." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Verify what you run" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="The source package includes the app, recovery logic, tests, and a GitHub Actions EXE build workflow. For a published release, compare its SHA-256 checksum and inspect the workflow and source commit. A checksum checks file identity; it is not a security audit or proof of reproducible builds." Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="Independent community tool by Uh. Not affiliated with Cfx.re or Rockstar Games. Performance depends on your hardware and server workload; this app does not measure or promise an FPS increase." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Text="Ready. No changes have been applied." Foreground="{StaticResource Muted}" FontSize="12"/></Border>
    </Grid>
  </Grid>
</Window>
